# Copy to mac_agent/.env and chmod 600.
#
# NOVA_CODE_TOKEN is a shared secret with the tower. Anyone who can present it
# can run coding agents against your repos, so treat it like an SSH key.
NOVA_CODE_WS_URL=ws://tower.local:8000/ws/coding
NOVA_CODE_TOKEN=

# Where bare repo names in a task are resolved from.
NOVA_CODE_REPOS_ROOT=/Users/nathandong/Desktop

# Worktrees are created here, outside the repos, so sessions cannot see each
# other's files or your own working tree.
NOVA_CODE_WORKTREE_ROOT=/Users/nathandong/.nova/worktrees

# acceptEdits: edit freely inside the workspace, no human here to click OK.
NOVA_CODE_PERMISSION_MODE=acceptEdits

# OS-level sandbox. Leave on.
NOVA_CODE_SANDBOX=1

# Optional guardrails.
# NOVA_CODE_MAX_BUDGET_USD=5
# NOVA_CODE_MODEL=claude-opus-5
